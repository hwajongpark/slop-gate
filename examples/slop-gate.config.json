{
  "include": [
    "**/*.md",
    "**/*.mdx"
  ],
  "exclude": [
    "node_modules/**",
    "CHANGELOG.md"
  ],
  "rules": [
    "punctuation",
    "vocabulary"
  ],
  "allow": [
    {
      "paths": [
        "content/ru/**",
        "content/ja/**"
      ],
      "rules": [
        "em-dash"
      ]
    }
  ]
}
